<% layout("/layouts/boilerplate") %>
<% const imageUrl = typeof listing.image === "string"
  ? listing.image
  : (listing.image && listing.image.url)
    ? listing.image.url
    : "https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1200&q=80"; %>
<% const isOwner = currUser && listing.owner && listing.owner._id.equals(currUser._id); %>
<div class="row">
  <div class="col-8 offset-2">

  
      <br><br>
      <h3><%= listing.title %></h3>
      <div class="card listing-card" col-6 offset-3 >
        <div class="card">
    <img src="<%= imageUrl %>" class="card-img-top show-img" alt="listing_image">
    <div class="card-body">
      <p class="card-text">
      
        </p>
        <p class="des">
          <i><%= listing.owner ? `Hosted by ${listing.owner.username}` : "Hosted by Unknown" %><br>  </i>
       <%= listing.description %><br>
        &#8377;<%= listing.price.toLocaleString("en-IN") %> / Night<br>
        <%= listing.location %><br>
        <%= listing.country %></p>
   </div>
  
  </div>
     
        <% if (isOwner) { %>
          <div class="show-actions">
            <a href="/listings/<%= listing._id %>/edit" class="btn-show btn-edit">Edit</a>

            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button type="submit" class="btn-show btn-delete">Delete</button>
            </form>
          </div>
        <% } %>
       
    
      </div>
    </div>
    
  </div>
  <div class="col-8 offset-2">
    <hr/>
    <% if (currUser) { %>
      <h4>Leave a Review</h4>
      <form  action="/listings/<%= listing._id %>/reviews" method="POST"
      novalidate
      class="needs-validation"
      >
      <div class="mb-3 mt-3">
        <label class="form-label">Rating</label>
        <fieldset class="starability-slot">
          <input type="radio" id="new-review-rate-1" name="review[rating]" value="1" required />
          <label for="new-review-rate-1" title="Terrible">1 star</label>
          <input type="radio" id="new-review-rate-2" name="review[rating]" value="2" />
          <label for="new-review-rate-2" title="Not good">2 stars</label>
          <input type="radio" id="new-review-rate-3" name="review[rating]" value="3" />
          <label for="new-review-rate-3" title="Average">3 stars</label>
          <input type="radio" id="new-review-rate-4" name="review[rating]" value="4" />
          <label for="new-review-rate-4" title="Very good">4 stars</label>
          <input type="radio" id="new-review-rate-5" name="review[rating]" value="5" />
          <label for="new-review-rate-5" title="Amazing">5 stars</label>
        </fieldset>
        <div class="invalid-feedback">Please select a rating.</div>
      </div>
      <div class="mb-3 mt-3" >
        <label for="comment" class="form-label">Comments</label>
        <textarea
        name="review[comment]"
        id="comment"
        cols="30"
        rows="5"
        class="form-control"
        required
        ></textarea>
        <div class="invalid-feedback">Please add some comments for review.</div>
      </div>
      <button type="submit" class="btn btn-outline-dark">Submit Review</button>
      </form>
    <% } %>
    <hr />
    <b>All Reviews</b>
    <div class="row mt-3">
     <% for (let review of listing.reviews) { %>
      <div class="card col-5 ms-3 mb-3 review-card">
        <div class="card-body review-card-body">
          <h5 class="card-title"><%= review.author ? review.author.username : "Anonymous" %></h5>
          <p class="card-text"><%= review.comment %></p>
          <p class="starability-result" data-rating="<%= review.rating %>">
            Rated: <%= review.rating %> stars
          </p>
          <% const isReviewAuthor = currUser && review.author && review.author._id.equals(currUser._id); %>
          <% if (isReviewAuthor) { %>
            <div class="review-actions">
            <button
              class="btn btn-sm btn-review-edit"
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#editReview-<%= review._id %>"
              aria-expanded="false"
              aria-controls="editReview-<%= review._id %>">
              Edit
            </button>
            <form
              class="mb-0"
              method="POST"
              action="/listings/<%= listing._id %>/reviews/<%= review._id %>/delete">
              <button type="submit" class="btn btn-sm btn-dark">Delete</button>
            </form>
            </div>
            <div class="collapse mt-3" id="editReview-<%= review._id %>">
            <div class="review-edit-card">
              <form
                method="POST"
                action="/listings/<%= listing._id %>/reviews/<%= review._id %>/update">
                <label for="comment-<%= review._id %>" class="form-label">Update Comment</label>
                <textarea
                  id="comment-<%= review._id %>"
                  name="review[comment]"
                  class="form-control mb-2"
                  rows="3"
                  required
                ><%= review.comment %></textarea>
                <label class="form-label">Update Rating</label>
                <fieldset class="starability-slot">
                  <input
                    type="radio"
                    id="edit-review-<%= review._id %>-rate-1"
                    name="review[rating]"
                    value="1"
                    <%= review.rating === 1 ? "checked" : "" %> />
                  <label for="edit-review-<%= review._id %>-rate-1" title="Terrible">1 star</label>
                  <input
                    type="radio"
                    id="edit-review-<%= review._id %>-rate-2"
                    name="review[rating]"
                    value="2"
                    <%= review.rating === 2 ? "checked" : "" %> />
                  <label for="edit-review-<%= review._id %>-rate-2" title="Not good">2 stars</label>
                  <input
                    type="radio"
                    id="edit-review-<%= review._id %>-rate-3"
                    name="review[rating]"
                    value="3"
                    <%= review.rating === 3 ? "checked" : "" %> />
                  <label for="edit-review-<%= review._id %>-rate-3" title="Average">3 stars</label>
                  <input
                    type="radio"
                    id="edit-review-<%= review._id %>-rate-4"
                    name="review[rating]"
                    value="4"
                    <%= review.rating === 4 ? "checked" : "" %> />
                  <label for="edit-review-<%= review._id %>-rate-4" title="Very good">4 stars</label>
                  <input
                    type="radio"
                    id="edit-review-<%= review._id %>-rate-5"
                    name="review[rating]"
                    value="5"
                    <%= review.rating === 5 ? "checked" : "" %> />
                  <label for="edit-review-<%= review._id %>-rate-5" title="Amazing">5 stars</label>
                </fieldset>
                <button type="submit" class="btn btn-sm btn-outline-dark">Update Review</button>
              </form>
            </div>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>
    </div>
    <h3>Where you will be</h3>
    <div class="row mt-3">
      <div class="col-12">
        <div id="map" style="width: 100%; height: 400px;"></div>
      </div>
    </div>
    <script>
      window.mapToken = "<%= process.env.MAP_TOKEN %>";
      window.mapCenter = <%- JSON.stringify(listing.geometry && listing.geometry.coordinates ? listing.geometry.coordinates : [77.2090, 28.6139]) %>;
    </script>
    <script src="/js/map.js"></script>
    </div>
</div>
